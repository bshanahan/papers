nout = 2000
timestep = 1e2

MYG = 2  # No guard cells in Y, 2D simulation

[mesh]
nx = 260
ny = 64
nz = 256

Lrad = 0.15  # Radial width of domain [m]
Lpol = 0.15  # Poloidal size of domain [m]

Bpxy = 2.5 #7  #2.50  # Poloidal magnetic field [T]
Rxy = 5.5   # Major radius [meters]

dx = Lrad / (nx-4) #* Rxy * Bpxy / (nx - 4)  # Poloidal flux
dz = Lpol / nz #/ Rxy / nz   # Angle

length = 100
#dymin = 0.1  # Minimum grid spacing near target, as fraction of average. Must be > 0 and < 1

# Parallel grid spacing — grid refinement near the divertor target (which is where the interesting
# stuff happens)
dy = (length / ny)# * (1 + (1-dymin)*(1-y/pi))

g_11 = 400.0*(2*y - 1)^2/cosh(40*x - 20)^4 + 1
g_12 = (40.0*y - 20.0)*(1.0*tanh(40*x - 20) - 1.5)/cosh(40*x - 20)^2
g_13 = 0
g_22 = 2.25*(0.666666666666667*tanh(40*x - 20) - 1)^2
g_23 = 0
g_33 = 1

Bxy = Bpxy
bxcvz = 1./Rxy^2  # Curvature

ixseps1 = -1
ixseps2 = -1  # -1 #nx/2

[mesh:paralleltransform]
type = identity

[solver]
mxstep = 10000

[hermes]
# Two species, electrons and ions
components = e, h+, sound_speed, vorticity, collisions, sheath_boundary, diamagnetic_drift

Nnorm = 1e19
Bnorm = mesh:Bxy
Tnorm = 50.0

recalculate_metric = false

[sheath_boundary]
# Set a sheath boundary condition at which the ends of the field-line
lower_y = true
upper_y = true

sin_alpha = sin(atan((1)/(20.0/cosh(40*x - 20))^2))

[e]
type = evolve_density, evolve_pressure, evolve_momentum

charge = -1
AA = 1/1836

poloidal_flows = true  # Y flows due to ExB
thermal_conduction = true  # Parallel heat conduction

[Ne]
function = 1.0 + 1e-3*mixmode(x)*mixmode(z)

x0 = 0.1
width = 0.02
source = 5e22 * exp(-((x-x0)/width)^2) # Units Nnorm/s

bndry_all = neumann

[Pe]
function = Ne:function

source = 2 * Ne:source * hermes:Tnorm * 1.602176634e-19

bndry_all = neumann

[h+]
# Set the density so that the plasma is quasineutral
type = quasineutral, evolve_pressure, evolve_momentum

charge = 1
AA = 1

bndry_flux = true
poloidal_flows = true
thermal_conduction = true

[Nh+]
function = Ne:function

[Ph+]
function = `Nh+:function`

source = 2 * Ne:source * hermes:Tnorm * 1.602176634e-19

bndry_all = neumann

[vorticity]

diamagnetic = true   # Include diamagnetic current?
diamagnetic_polarisation = true # Include diamagnetic drift in polarisation current?
average_atomic_mass = 1.0   # Weighted average atomic mass, for polarisaion current
bndry_flux = true # Allow flows through radial boundaries
poloidal_flows = true  # Include poloidal ExB flow
split_n0 = false  # Split phi into n=0 and n!=0 components
phi_dissipation = true

# [vorticity:laplacian]
# type = petsc3damg
# dtol = 1e8
# [sheath_closure]
# connection_length = 50+500*H(0.5-x) # meters
# potential_offset = 0.0  # Potential at which sheath current is zero
# sinks = true
